<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- The API key is user-supplied and must never leave the device (ADR-002). -->
    <exclude
        domain="file"
        path="datastore/secrets.preferences_pb" />
    <!-- A running countdown is device-session state, not user data to restore elsewhere. -->
    <exclude
        domain="file"
        path="datastore/cooking_timer.preferences_pb" />
</full-backup-content>
