<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The only network the app does is calling api.anthropic.com with the user's own key,
        and fetching pages the user asks to import. Everything else stays on the device.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Package visibility for the camera app. Without this, resolving ACTION_IMAGE_CAPTURE
        fails on API 30+ and "take a photo" silently does nothing.

        No CAMERA permission is declared on purpose: the capture is delegated to whatever
        camera app the user has, so the app never needs the permission itself — and
        declaring it would force a runtime prompt for no reason.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".ReceptariApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Receptari">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Receptari"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the camera app a writable file to capture into. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
