<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Internet access is limited to api.anthropic.com with the user's own key and pages the
        user asks to import. Nearby recipe copies use a direct local device-to-device connection.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Runtime permissions used only while directly sending or receiving a nearby copy. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!--
        Package visibility for the camera app. Without this, resolving ACTION_IMAGE_CAPTURE
        fails on API 30+ and "take a photo" silently does nothing.

        No CAMERA permission is declared on purpose: the capture is delegated to whatever
        camera app the user has, so the app never needs the permission itself — and
        declaring it would force a runtime prompt for no reason.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".ReceptariApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Receptari">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Receptari"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.transfer.TransferImportActivity"
            android:exported="true"
            android:label="@string/transfer_receive_title"
            android:theme="@style/Theme.Receptari">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.cat.receptari.recipe-transfer" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.cat.receptari.recipe-transfer" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.transfer.NearbyTransferActivity"
            android:exported="false"
            android:theme="@style/Theme.Receptari" />

        <receiver
            android:name=".data.timer.TimerAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.timer.TimerBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Hands the camera app a writable file to capture into. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
